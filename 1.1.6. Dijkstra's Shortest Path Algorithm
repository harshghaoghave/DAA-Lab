#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

void dijkstra(int G[MAX][MAX], int n, int startnode) {
    int dist[MAX], parent[MAX], visited[MAX];
    int i, min, u;

    for (i = 1; i <= n; i++) {
        visited[i] = 0;
        if (i == startnode) {
            dist[i] = 0;
            parent[i] = -1;
        } else if (G[startnode][i] != 0) {
            dist[i] = G[startnode][i];
            parent[i] = startnode;
        } else {
            dist[i] = INFINITY;
            parent[i] = -1;
        }
    }

    for (i = 1; i <= n; i++) {
        min = INFINITY;
        u = -1;
        for (int v = 1; v <= n; v++) {
            if (!visited[v] && dist[v] < min) {
                min = dist[v];
                u = v;
            }
        }
        if (u == -1) break;
        visited[u] = 1;
} 
