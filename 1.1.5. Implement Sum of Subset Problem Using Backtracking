#include <stdio.h>

#define MAX 20
#define MAX_SOLUTIONS (1 << MAX)

int arr[MAX], subset[MAX];
int solutions[MAX_SOLUTIONS][MAX];
int lengths[MAX_SOLUTIONS];
int n, target, total = 0;

void findSubsets(int index, int sum, int count) {
    if (index == n) {
        if (sum == target) {
            for (int i = 0; i < count; i++)
                solutions[total][i] = subset[i];

            lengths[total++] = count;
        }
        return;
    }

    /* Include the current element */
    subset[count] = arr[index];
    findSubsets(index + 1, sum + arr[index], count + 1);

    /* Exclude the current element */
    findSubsets(index + 1, sum, count);
}

int main(void) {
    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    scanf("%d", &target);
}
